+.agent-group-switcher-dropdown-wrap select {
+  width: 100%;
+  padding: 4px 8px;
+  border: 1px solid var(--border);
+  border-radius: 999px;
+  background: var(--surface);
+  color: var(--text-secondary);
+  font-size: 11.5px;
+  font-weight: 600;
+}
+.agent-group-switcher-scrubber {
+  display: none;
+  width: 24px;
+  height: 24px;
