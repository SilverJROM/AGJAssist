+  await page.mouse.move(box!.x - 220, box!.y + box!.height / 2, { steps: 6 });
+  await page.mouse.up();
+
+  await expect.poll(() => strip.evaluate((element) => element.scrollLeft)).toBeGreaterThan(overflow.left);
+  await writeEvidence(page, 'F5-wide-a4-after');
+});
