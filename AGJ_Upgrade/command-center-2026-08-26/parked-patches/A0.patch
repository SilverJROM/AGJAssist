+  testDir: 'e2e',
+  timeout: 30000,
+  projects: [
+    { name: 'cc', use: { ...devices['Desktop Chrome'], baseURL: 'http://localhost:3210' } },
+  ],
+  webServer: {
+    command: 'node scripts/cc-run-isolated.mjs --serve',
+    url: 'http://localhost:3210/index.html',
+    reuseExistingServer: false,
+    timeout: 60000,
+  },
+});
